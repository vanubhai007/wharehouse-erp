# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas - database name must be hrwarehouse
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hrwarehouse?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_RESET_SECRET=replace_with_another_long_random_string
JWT_RESET_EXPIRES_IN=15m

# Cloudinary (image/document storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (for CORS + password reset links)
FRONTEND_URL=http://localhost:5173

# Number of reverse proxies in front of the backend (0-5). Used to find the real
# client IP for login/forgot-password rate limits. Leave empty locally (forwarded
# headers are then ignored). On Render (single instance) use 1 - but verify your
# proxy setup first: too low groups all users under one IP, too high lets clients
# fake their IP.
TRUST_PROXY=

# Email provider (optional - leave blank to run notifications in DEMO MODE)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="HR Warehouse <no-reply@hrwarehouse.com>"

# WhatsApp Business API provider (optional - leave blank to run in DEMO MODE)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# First-Admin setup token. Required in production to use /setup (and enforced in
# any environment once set). Use a long random value, enter it on the /setup
# page, and remove it after the first Admin account has been created.
SETUP_TOKEN=

# Admin account for the demo seed script (development only - refuses production).
# Replace the placeholder: the seed script refuses to run with it, and the
# password must be at least 12 characters. It is never printed.
SEED_ADMIN_EMAIL=admin@hrwarehouse.com
SEED_ADMIN_PASSWORD=ChangeMe123!
