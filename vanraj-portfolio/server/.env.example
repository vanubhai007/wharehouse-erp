# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/vanraj-portfolio?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign admin JWTs — generate a long random string
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Used only by seed/createAdmin.js to create the first admin account
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password
